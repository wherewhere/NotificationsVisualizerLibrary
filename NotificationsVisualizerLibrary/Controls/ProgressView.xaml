<UserControl
    x:Class="NotificationsVisualizerLibrary.Controls.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:NotificationsVisualizerLibrary.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotificationsVisualizerLibrary.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="using:NotificationsVisualizerLibrary.Model"
    d:DataContext="{d:DesignInstance Type=model:AdaptiveProgress}"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///NotificationsVisualizerLibrary/Themes/Generic.xaml" />
                <ResourceDictionary>
                    <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
                </ResourceDictionary>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Name="ProgressGrid" Margin="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.ColumnSpan="2"
            Foreground="{ThemeResource ForegroundBaseHighBrush}"
            MaxLines="1"
            Style="{StaticResource LocBodyTextBlockStyle}"
            Text="{Binding Title}"
            TextTrimming="Clip"
            TextWrapping="NoWrap"
            Visibility="{Binding Title, Converter={StaticResource StringToVisibilityConverter}}" />

        <ProgressBar
            x:Name="progressBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,8,0,8"
            Foreground="{ThemeResource ProgressBarForegroundBrush}"
            IsIndeterminate="{Binding IsIndeterminate}"
            Maximum="1.0"
            Value="{Binding Value}" />

        <TextBlock
            Grid.Row="2"
            Foreground="{ThemeResource ProgressTextForegroundBrush}"
            MaxLines="1"
            Style="{StaticResource LocBodyTextBlockStyle}"
            Text="{Binding Status}"
            TextTrimming="Clip"
            TextWrapping="NoWrap" />

        <TextBlock
            Grid.Row="2"
            Grid.Column="1"
            MaxWidth="162"
            Margin="12,0,0,0"
            Foreground="{ThemeResource ProgressTextForegroundBrush}"
            MaxLines="1"
            Style="{StaticResource LocBodyTextBlockStyle}"
            Text="{Binding ValueString}"
            TextAlignment="Right"
            TextTrimming="Clip"
            TextWrapping="NoWrap" />
    </Grid>
</UserControl>
