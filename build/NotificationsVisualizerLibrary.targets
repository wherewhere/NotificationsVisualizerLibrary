<Project>

  <UsingTask
    TaskName="DisableWarningsInGeneratedSources"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <GeneratedSource ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
            if (GeneratedSource == null)
            {
                return _Success;
            }

            try
            {
                Regex regex = new Regex("#line \\d+ \"(.*)\"");
                foreach (ITaskItem item in GeneratedSource)
                {
                    string path = item.ItemSpec;
                    if (File.Exists(path))
                    {
                        const string signature = "// Patched by 'DisableWarningsInGeneratedSources' task";
                        StringBuilder sb = new StringBuilder();
                        using (StreamReader reader = new StreamReader(path))
                        {
                            string line = reader.ReadLine();
                            if (line == signature) { continue; }
                            sb.AppendLine(signature)
                              .AppendLine("#pragma warning disable")
                              .AppendLine(line);
                            while (!reader.EndOfStream)
                            {
                                line = reader.ReadLine();
                                Match match = regex.Match(line);
                                if (match.Success)
                                {
                                    string root = Path.GetDirectoryName(path);
                                    string file = match.Groups[1].Value;
                                    if (!File.Exists(Path.Combine(root, file)))
                                    {
                                        string temp = $"..\\{file}";
                                        if (File.Exists(Path.Combine(root, temp)))
                                        {
                                            line = line.Replace(file, temp);
                                        }
                                        else
                                        {
                                            line = line.Replace(match.Value, $"#line default // {file} not found");
                                        }
                                    }
                                }
                                sb.AppendLine(line);
                            }
                        }
                        File.WriteAllText(path, sb.ToString());
                    }
                }
            }
            catch (Exception)
            {
                Log.LogError("Failed to disable warnings in GeneratedSources.");
                _Success = false;
            }
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- https://weblogs.asp.net/rweigelt/disable-warnings-in-generated-c-files-of-uwp-app -->
  <Target Name="_DisableWarningsInGeneratedSources" AfterTargets="MarkupCompilePass2">
    <ItemGroup>
      <GeneratedSource Include="**\*.g.cs;**\*.g.i.cs" />
    </ItemGroup>
    <Message Text="GeneratedSource: @(GeneratedSource->'&quot;%(Identity)&quot;')" />
    <DisableWarningsInGeneratedSources GeneratedSource="@(GeneratedSource)" />
  </Target>

</Project>