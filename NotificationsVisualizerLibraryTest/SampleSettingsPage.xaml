<Page
    x:Class="NotificationsVisualizerLibraryTest.SampleSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotificationsVisualizerLibraryTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:visualizer="using:NotificationsVisualizerLibrary"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="20">

            <visualizer:PreviewTile x:Name="MediumPreviewTile" IsAnimationEnabled="False" />

            <visualizer:PreviewTile
                x:Name="WidePreviewTile"
                Margin="0,6,0,0"
                IsAnimationEnabled="False"
                TileSize="Wide" />

            <ToggleSwitch
                x:Name="ToggleShowHomework"
                Margin="0,24,0,0"
                Header="Show incomplete homework"
                IsOn="True" />

            <ToggleSwitch
                x:Name="ToggleShowExams"
                Margin="0,12,0,0"
                Header="Show upcoming exams"
                IsOn="True" />

        </StackPanel>

    </ScrollViewer>
</Page>
