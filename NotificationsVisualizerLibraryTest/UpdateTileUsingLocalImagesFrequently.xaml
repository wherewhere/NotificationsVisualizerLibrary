<Page
    x:Class="NotificationsVisualizerLibraryTest.UpdateTileUsingLocalImagesFrequently"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotificationsVisualizerLibraryTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:visualizer="using:NotificationsVisualizerLibrary"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid>

        <StackPanel>
            <visualizer:PreviewTile
                x:Name="WidePreviewTile"
                IsAnimationEnabled="False"
                TileSize="Wide" />

            <Button
                x:Name="ButtonUpdateImage"
                Click="ButtonUpdateImage_Click"
                Content="Update Image" />

        </StackPanel>

    </Grid>
</Page>
