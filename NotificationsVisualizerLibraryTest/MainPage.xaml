<Page
    x:Class="NotificationsVisualizerLibraryTest.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:NotificationsVisualizerLibraryTest"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:templateVisualizerLibrary="using:NotificationsVisualizerLibrary"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    NavigationCacheMode="Enabled"
    mc:Ignorable="d">

    <ScrollViewer x:Name="Root">

        <StackPanel>

            <Button
                x:Name="ButtonOpenSampleSettingsPage"
                Click="ButtonOpenSampleSettingsPage_Click"
                Content="Open Sample Settings Page" />

            <Button
                x:Name="ButtonOpenUpdateImageInUsePage"
                Click="ButtonOpenUpdateImageInUsePage_Click"
                Content="Open Update Image In Use Page" />

            <Button
                x:Name="ButtonUpdateLocalImageFrequently"
                Click="ButtonUpdateLocalImageFrequently_Click"
                Content="Open Update Local Image Frequently Page" />
        </StackPanel>

    </ScrollViewer>
</Page>
